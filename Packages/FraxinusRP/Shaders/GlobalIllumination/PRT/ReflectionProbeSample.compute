// Reflection Probe Sampling Compute Shader
// Samples reflection probe cubemap and projects to spherical harmonics
#pragma kernel CSMain

TextureCube<float4> _InputCubemap;
SamplerState sampler_InputCubemap;

RWStructuredBuffer<float> _CoefficientSH9; // 27 floats (9 coefficients * 3 channels RGB)

float _RandSeed;

// Constants for spherical harmonics
static const float k_pi = 3.14159265359;
static const float k_2pi = 6.28318530718;

// SH basis functions (L2)
float SH_Basis_L0_M0() { return 0.282095; }
float SH_Basis_L1_M_1(float3 dir) { return 0.488603 * dir.y; }
float SH_Basis_L1_M0(float3 dir) { return 0.488603 * dir.z; }
float SH_Basis_L1_M1(float3 dir) { return 0.488603 * dir.x; }
float SH_Basis_L2_M_2(float3 dir) { return 1.092548 * dir.x * dir.y; }
float SH_Basis_L2_M_1(float3 dir) { return 1.092548 * dir.y * dir.z; }
float SH_Basis_L2_M0(float3 dir) { return 0.315392 * (3.0 * dir.z * dir.z - 1.0); }
float SH_Basis_L2_M1(float3 dir) { return 1.092548 * dir.x * dir.z; }
float SH_Basis_L2_M2(float3 dir) { return 0.546274 * (dir.x * dir.x - dir.y * dir.y); }

// Generate uniform random samples on sphere using Fibonacci lattice
float3 FibonacciSpherePoint(uint i, uint numSamples, float randomOffset)
{
    float phi = k_2pi * (i + randomOffset) / 1.6180339887; // golden ratio
    float cosTheta = 1.0 - (2.0 * i + 1.0) / numSamples;
    float sinTheta = sqrt(1.0 - cosTheta * cosTheta);
    
    float cosPhi = cos(phi);
    float sinPhi = sin(phi);
    
    return float3(sinTheta * cosPhi, sinTheta * sinPhi, cosTheta);
}

[numthreads(1, 1, 1)]
void CSMain(uint3 id : SV_DispatchThreadID)
{
    // Initialize coefficients to zero
    for (int i = 0; i < 27; i++)
    {
        _CoefficientSH9[i] = 0.0;
    }
    
    // Number of samples for Monte Carlo integration
    const uint numSamples = 2048;
    float3 shCoeffs[9];
    
    // Initialize SH coefficients for RGB
    for (int ch = 0; ch < 3; ch++)
    {
        for (int i = 0; i < 9; i++)
        {
            shCoeffs[i] = 0.0;
        }
        
        // Monte Carlo integration
        for (uint s = 0; s < numSamples; s++)
        {
            // Generate sample direction
            float3 dir = FibonacciSpherePoint(s, numSamples, _RandSeed);
            
            // Sample cubemap
            float4 sample = _InputCubemap.SampleLevel(sampler_InputCubemap, dir, 0);
            float3 radiance = sample.rgb;
            
            // Weight by solid angle (uniform for Fibonacci sphere)
            float weight = 4.0 * k_pi / numSamples;
            
            // Project onto SH basis
            shCoeffs[0] += radiance * SH_Basis_L0_M0() * weight;
            shCoeffs[1] += radiance * SH_Basis_L1_M_1(dir) * weight;
            shCoeffs[2] += radiance * SH_Basis_L1_M0(dir) * weight;
            shCoeffs[3] += radiance * SH_Basis_L1_M1(dir) * weight;
            shCoeffs[4] += radiance * SH_Basis_L2_M_2(dir) * weight;
            shCoeffs[5] += radiance * SH_Basis_L2_M_1(dir) * weight;
            shCoeffs[6] += radiance * SH_Basis_L2_M0(dir) * weight;
            shCoeffs[7] += radiance * SH_Basis_L2_M1(dir) * weight;
            shCoeffs[8] += radiance * SH_Basis_L2_M2(dir) * weight;
        }
        
        // Store coefficients (interleaved RGB: [R0, G0, B0, R1, G1, B1, ...])
        for (int k = 0; k < 9; k++)
        {
            _CoefficientSH9[k * 3 + ch] = shCoeffs[k][ch];
        }
    }
}

